FROM python:3.14-slim

# Git needed for gitpython (commit SHA tracking, repo cloning)
RUN apt-get update && apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── Full indexer dependencies ────────────────────────────────────────
# The indexer owns all data access: tree-sitter chunking, TEI embedding,
# Milvus inserts, Neo4j graph writes, PostgreSQL job state.
#
# Only the files the package build needs are copied (see .dockerignore for
# what is excluded — notably `.env`). `src/` stays on the image because the
# SQL migrations under adapters/postgresql/migrations are not packaged into
# the wheel; PYTHONPATH below makes the source tree the import root.
COPY pyproject.toml README.md LICENSE ./
COPY src/ src/
RUN pip install --no-cache-dir . && \
    pip install --no-cache-dir supervisor && \
    rm -rf build src/*.egg-info

# Pre-download tiktoken encoding cache so the container doesn't need
# outbound internet at runtime.  The indexer imports tiktoken at module
# load (adapters/tree_sitter/indexer.py) and `get_encoding()` hits
# openaipublic.blob.core.windows.net on first call.
RUN python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')"

# Pre-download the tree-sitter parsers for the same reason. tree-sitter-
# language-pack fetches each grammar from GitHub on first use; when that fails
# at runtime the indexer silently falls back to character windows. The CLI
# retries with backoff, then exits non-zero unless every LANGUAGE_MAP parser
# loads, so a failed download fails the build here. It runs against the
# installed package (the `pip install .` above), before PYTHONPATH is set, so
# it exercises what `pip` shipped. The cache lands under the build user's
# ~/.cache/tree-sitter-language-pack: this image runs as root with no USER
# line, so build and runtime match. If a USER is ever added, move the cache
# (or set the pack's cache dir) so the runtime user finds it.
RUN python -m treeweft.adapters.tree_sitter.parsers --prefetch

ENV PYTHONPATH=/app/src
ENV RUST_MIN_STACK=8388608

# CalVer product release, set by the publish workflow; empty for local builds.
# Declared late so a new release doesn't invalidate the dependency layers.
ARG TREEWEFT_RELEASE=""
ENV TREEWEFT_RELEASE=$TREEWEFT_RELEASE

EXPOSE 8001
CMD ["uvicorn", "treeweft.indexer_service:app", "--host", "0.0.0.0", "--port", "8001"]
